<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ArtFruit</AssemblyName>
    <RootNamespace>ArtFruit</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.1.9</Version>


    <Company>bpiche</Company>

    <Product>ArtFruit</Product>
    <Description>Rotate your Windows desktop wallpaper through public domain artwork.</Description>

    <!-- Self-contained single-file publish defaults -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Use the Windows .ico as the exe icon only when it exists (see Resources/README). -->
  <PropertyGroup Condition="Exists('Resources\ArtFruit.ico')">
    <ApplicationIcon>Resources\ArtFruit.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ship the icon next to the exe if present (tray icon falls back gracefully). -->
    <None Include="Resources\ArtFruit.ico" Condition="Exists('Resources\ArtFruit.ico')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Resources\ArtFruit.ico</Link>
    </None>
  </ItemGroup>

</Project>

